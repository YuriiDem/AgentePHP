{
    "name": "ydem/agente-php",
    "description": "A lightweight, approachable agentic framework for PHP: agents, tools, structured output, retrieval and workflows.",
    "keywords": [
        "ai",
        "agents",
        "llm",
        "openai",
        "anthropic",
        "ollama",
        "rag",
        "function-calling",
        "workflow"
    ],
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "YDem",
            "email": "yurademchuk3005@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "AgentePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentePHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite=unit --colors=always",
        "analyse": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix",
        "style:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@style:check",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the whole PHPUnit suite.",
        "test:unit": "Run only unit tests (no network).",
        "analyse": "Run PHPStan static analysis at max level.",
        "style": "Fix code style with PHP CS Fixer.",
        "check": "Full verification: style + static analysis + tests."
    },
    "config": {
        "sort-packages": true
    }
}
